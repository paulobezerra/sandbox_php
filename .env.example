# Valores apenas para desenvolvimento local. Gere credenciais próprias para produção.
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-local-root-password
APP_PORT=8080
APP_ENV=development
APP_DEBUG=false
OPENAPI_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CHARSET=utf8mb4
APP_URL=http://localhost:8080
SESSION_COOKIE=skeleton_session
# Set the reverse proxy IP/CIDR(s) here when deployed behind a proxy.
TRUSTED_PROXIES=
