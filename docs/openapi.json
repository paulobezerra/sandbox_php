{
    "openapi": "3.1.0",
    "info": {
        "title": "Sandbox PHP API",
        "description": "Skeleton HTTP API. Authentication uses a PHP session with an HttpOnly, SameSite=Lax cookie that is Secure according to APP_URL. Every mutating operation requires an X-CSRF-Token obtained from GET /api/auth/csrf or /api/auth/me, except for an exact anonymous exception declared in the application composition; authenticated sessions can never use these exceptions.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "paths": {
        "/api/auth/csrf": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "operationId": "ab524af6c7c90298c1e3a82793bb6598",
                "parameters": [
                    {
                        "name": "Accept-Language",
                        "in": "header",
                        "description": "Selects the language of application-owned response messages.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "CSRF token for the session"
                    }
                }
            }
        },
        "/api/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "operationId": "65caa1792e73f25ec9c158f684725ca2",
                "parameters": [
                    {
                        "name": "Accept-Language",
                        "in": "header",
                        "description": "Selects the language of application-owned response messages.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 12
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created"
                    },
                    "400": {
                        "description": "Invalid request payload"
                    },
                    "409": {
                        "description": "Email already registered"
                    },
                    "422": {
                        "description": "Invalid account data"
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "operationId": "18468d1b085a6893ecda31943aa8ace7",
                "parameters": [
                    {
                        "name": "Accept-Language",
                        "in": "header",
                        "description": "Selects the language of application-owned response messages.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Session started and CSRF token renewed"
                    },
                    "400": {
                        "description": "Invalid request payload"
                    },
                    "401": {
                        "description": "Invalid credentials"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "operationId": "a8949cd76ed14d60327f211285aae94f",
                "parameters": [
                    {
                        "name": "Accept-Language",
                        "in": "header",
                        "description": "Selects the language of application-owned response messages.",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Session ended"
                    }
                }
            }
        },
