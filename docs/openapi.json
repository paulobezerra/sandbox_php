    "components": {
        "schemas": {
            "Error": {
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "required": [
                            "status",
                            "message"
                        ],
                        "properties": {
                            "status": {
                                "type": "integer"
                            },
                            "message": {
                                "type": "string"
                            },
                            "details": {
                                "type": "object",
                                "additionalProperties": true
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "Post": {
                "required": [
                    "id",
                    "title",
                    "slug",
                    "content",
                    "status",
                    "publishedAt",
                    "createdAt"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "content": {
                        "description": "Markdown source",
                        "type": "string"
                    },
                    "excerpt": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "DRAFT",
                            "PUBLISHED"
                        ]
                    },
                    "authorId": {
                        "type": "integer"
                    },
                    "publishedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time"
                    },
                    "html": {
                        "description": "Escaped Markdown HTML, included in the public API",
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "Pagination": {
                "required": [
                    "total",
                    "page",
                    "perPage"
                ],
                "properties": {
                    "total": {
                        "type": "integer"
                    },
                    "page": {
                        "type": "integer"
                    },
                    "perPage": {
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "PostCollection": {
                "type": "object",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Pagination"
                    },
                    {
                        "properties": {
                            "items": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Post"
                                }
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "PostResult": {
                "required": [
                    "post"
                ],
                "properties": {
                    "post": {
                        "$ref": "#/components/schemas/Post"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "description": "PHP session; mutating operations require an X-CSRF-Token obtained from /api/auth/csrf or /api/auth/me.",
                "name": "sandbox_session",
                "in": "cookie"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Posts",
            "description": "Posts"
        }
    ]
