{
  "name": "app/slim-vue",
  "description": "Aplicação Slim 4 com Vue 3 e MySQL",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-pdo_mysql": "*",
    "slim/slim": "^4.0",
    "slim/psr7": "^1.0",
    "ext-pdo": "*",
    "robmorgan/phinx": "^0.16.12",
    "juliangut/slim-routing": "^3.2",
    "php-di/php-di": "^7.0",
    "swagger-api/swagger-ui": "^5.33",
    "symfony/cache": "^7.4",
    "league/commonmark": "^2.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "zircote/swagger-php": "^6.14"
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "openapi:generate": "vendor/bin/openapi src/Infrastructure/Http -e src/Infrastructure/Http/Controller/PlanController.php -o docs/openapi.json",
    "assets:publish": "php tools/publish-swagger-ui.php",
    "post-install-cmd": ["@assets:publish"],
    "post-update-cmd": ["@assets:publish"],
    "migrate": "vendor/bin/phinx migrate",
    "migrate:rollback": "vendor/bin/phinx rollback",
    "migrate:status": "vendor/bin/phinx status"
  }
}
