{
  "name": "app/slim-vue",
  "description": "Aplicação Slim 4 com Vue 3 e MySQL",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-pdo_mysql": "*",
    "slim/slim": "^4.0",
    "slim/psr7": "^1.0",
    "ext-pdo": "*",
    "robmorgan/phinx": "^0.16.12",
    "juliangut/slim-routing": "^3.2",
    "php-di/php-di": "^7.0",
    "swagger-api/swagger-ui": "^5.33",
    "league/commonmark": "^2.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "zircote/swagger-php": "^6.14",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "lint": [
      "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --using-cache=no",
      "@php tools/lint-php.php"
    ],
    "test": "vendor/bin/phpunit",
    "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-clover=/tmp/sandbox-php-coverage.xml",
    "coverage:check": "php tools/check-coverage.php /tmp/sandbox-php-coverage.xml 80",
    "openapi:generate": "vendor/bin/openapi src/Infrastructure/Http -o docs/openapi.json",
    "openapi:check": "vendor/bin/phpunit --filter OpenApiRoutesTest",
    "quality": [
      "@lint",
      "@test:coverage",
      "@coverage:check",
      "@php vendor/bin/phpstan analyse --no-progress",
      "@openapi:check"
    ],
    "assets:publish": "php tools/publish-swagger-ui.php",
    "post-install-cmd": ["@assets:publish"],
    "post-update-cmd": ["@assets:publish"],
    "migrate": "vendor/bin/phinx migrate",
    "migrate:rollback": "vendor/bin/phinx rollback",
    "migrate:status": "vendor/bin/phinx status"
  }
}
